# ===================================================
# Server Configuration
# ===================================================
SERVER_PORT=8080
GIN_MODE=release
TZ=UTC
# Set to true when serving over HTTPS so auth cookies get the Secure flag.
# (Secure cookies are dropped by browsers over plain HTTP.)
COOKIE_SECURE=false

# ===================================================
# Database Configuration (PostgreSQL)
# ===================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=watchtower
DB_SSL_MODE=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# ===================================================
# Admin Account (used to log in to the dashboard)
# Applied on FIRST BOOT only; an existing admin is never overwritten.
# Set ADMIN_RESET_PASSWORD=true to force a reset on the next boot.
# ===================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=superSecret123!
ADMIN_RESET_PASSWORD=false

# ===================================================
# JWT Configuration
# ===================================================
JWT_SECRET_KEY=sample_secret_key
JWT_EXPIRATION_DURATION=24h
JWT_REFRESH_SECRET_KEY=sample_refresh_secret_key
JWT_REFRESH_EXPIRATION_DURATION=168h

# ===================================================
# Rate Limiting
# ===================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ===================================================
# Alert Notification Worker Pool
# ===================================================
NOTIFIER_WORKERS=5

# ===================================================
# Event Ingestion / Deduplication
# FINGERPRINT_MODE: type+frames (default) | type | message | heuristic
#   type+frames: group by error type + normalized stack frames
#   type:        group by error type only (whole project)
#   message:     group by error type + exact normalized message
#   heuristic:   group by error type + top frame function + normalized message
#                (ids, timestamps, urls, numbers masked Sentry-style)
# ===================================================
FINGERPRINT_MODE=type+frames

# ===================================================
# CORS Configuration
# Use comma-separated values if multiple
# ===================================================
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID

# ===================================================
# Logger Configuration
# LOGGER_OUTPUT: stdout | file | both
# LOGGER_LEVEL: debug | info | warn | error | trace
# ===================================================
LOGGER_OUTPUT=stdout
LOGGER_LEVEL=info

LOGGER_FILENAME=watchtower
LOGGER_LOG_DIR=logs

LOGGER_MAX_SIZE_MB=100
LOGGER_MAX_BACKUPS=7
LOGGER_MAX_AGE_DAYS=30
LOGGER_COMPRESS=true
LOGGER_ENABLE_CALLER=true
