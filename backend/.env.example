# Copy to .env and adjust for your environment: cp backend/.env.example backend/.env

SERVER_PORT=8080
GIN_MODE=release
TZ=UTC

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=watchtower
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

ADMIN_USERNAME=admin
# Password is applied on first boot only (an existing admin is never touched).
# Set ADMIN_RESET_PASSWORD=true to force-reset the password on the next boot.
ADMIN_PASSWORD=change-me
ADMIN_RESET_PASSWORD=false

JWT_SECRET_KEY=change-me-access-secret
JWT_EXPIRATION_DURATION=24h
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
JWT_REFRESH_EXPIRATION_DURATION=168h

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID,X-Api-Key

LOGGER_OUTPUT=both
LOGGER_LEVEL=debug
LOGGER_FILENAME=watchtower
LOGGER_LOG_DIR=logs
LOGGER_MAX_SIZE_MB=100
LOGGER_MAX_BACKUPS=7
LOGGER_MAX_AGE_DAYS=30
LOGGER_COMPRESS=true
LOGGER_ENABLE_CALLER=true

# Self-reporting (dogfooding). Delivered in-process, so no API key or endpoint
# is needed: the backend posts its own errors straight into its ingestion
# pipeline and they land under the project below.
SELF_REPORT_ENABLED=true
SELF_REPORT_PROJECT=watchtower-self
# "error" gives full dogfooding visibility; "fatal" is quieter.
SELF_REPORT_LEVEL=error
# Optional:
# SELF_REPORT_RELEASE=
